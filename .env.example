# --- Vercel Blob (fotos + datos del admin) ---
# Se genera solo al crear un Blob Store en tu proyecto de Vercel
# (Storage → Create Database → Blob). Copia el token que te da ahí.
BLOB_READ_WRITE_TOKEN=

# --- Acceso al panel /admin ---
# Contraseña compartida para entrar a /admin. Cámbiala por la tuya.
ADMIN_PASSWORD=

# Cadena larga y aleatoria para firmar la sesión del admin.
# Genera una con: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Datos públicos del sitio (aparecen en Contacto y el footer) ---
NEXT_PUBLIC_CONTACT_EMAIL=hola@solaya.com
NEXT_PUBLIC_CITY=Zacatecas

# Número de WhatsApp en formato internacional SIN espacios ni signos,
# ej. 5215512345678 (52 = México, 1 = celular, luego el número a 10 dígitos).
# Si lo dejas vacío, el botón flotante de WhatsApp no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY=

# Opcionales — si no los defines, el footer los muestra sin link.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_PINTEREST_URL=
